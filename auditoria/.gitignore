# ==========================================
# Directorios Privados y Sensibles
# ==========================================
private/
private/**
.env
.env.local
.env.*.local

# ==========================================
# macOS (Archivos de sistema y metadatos)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Archivos de caché y previsualización de carpetas de macOS
*.icloud

# ==========================================
# Windows (Archivos de sistema y miniaturas)
# ==========================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

